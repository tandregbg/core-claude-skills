#!/bin/bash
# pre-push guard (CR-026) — blocks pushes whose ADDED lines contain secrets
# or private identifiers. The vault is production data and this repo is
# public; this hook is the fail-closed backstop behind the primary rule
# (write generic by construction — see docs/RELEASING.md).
#
# Install (per clone):
#   git config core.hooksPath scripts/githooks
#   git config guard.denylist /absolute/path/to/private/push-denylist.txt
#
# The denylist is PRIVATE (real names/hosts, one regex per line, # comments)
# and must never live in this repo. Missing denylist = push blocked.
# Escape hatch: `git push --no-verify` — manual review first, then own it.

set -u

# Built-in generic secret patterns (safe to publish: patterns, not data).
# Deliberately narrow — no bare common words (they false-positive on
# legitimate rule text like "password-manager reference").
BUILTIN_PATTERNS=(
  'sk-ant-[A-Za-z0-9_-]{8,}'
  'sk-or-v1-[A-Za-z0-9]{8,}'
  'sk-proj-[A-Za-z0-9_-]{8,}'
  'ghp_[A-Za-z0-9]{20,}'
  'gho_[A-Za-z0-9]{20,}'
  'AKIA[0-9A-Z]{16}'
  'BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY'
  '\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b'
  '\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b'
  'sshpass[[:space:]]+-p'
)
# (The [[:space:]] spelling keeps patterns from matching their own source
# line when this file itself is committed — the guard once blocked itself.)

DENYLIST="$(git config guard.denylist || true)"
if [ -z "$DENYLIST" ] || [ ! -r "$DENYLIST" ]; then
    echo "PUSH BLOCKED (fail-closed): private denylist not configured or unreadable." >&2
    echo "  git config guard.denylist /absolute/path/to/private/push-denylist.txt" >&2
    echo "See docs/RELEASING.md (CR-026)." >&2
    exit 1
fi

ZERO="0000000000000000000000000000000000000000"
FAIL=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue   # ref deletion — nothing outgoing
    if [ "$remote_sha" = "$ZERO" ]; then
        RANGE="$local_sha --not --remotes"
    else
        RANGE="$remote_sha..$local_sha"
    fi

    # Added lines only, across all outgoing commits.
    ADDED=$(git log -p --format= $RANGE 2>/dev/null | grep '^+' | grep -v '^+++' || true)
    [ -z "$ADDED" ] && continue

    for pat in "${BUILTIN_PATTERNS[@]}"; do
        HITS=$(printf '%s\n' "$ADDED" | grep -cE "$pat" || true)
        if [ "${HITS:-0}" -gt 0 ]; then
            echo "PUSH BLOCKED: built-in secret pattern matched ($HITS line[s]): $pat" >&2
            printf '%s\n' "$ADDED" | grep -nE "$pat" | head -5 >&2
            FAIL=1
        fi
    done

    while IFS= read -r pat; do
        case "$pat" in ''|'#'*) continue;; esac
        HITS=$(printf '%s\n' "$ADDED" | grep -cE "$pat" || true)
        if [ "${HITS:-0}" -gt 0 ]; then
            echo "PUSH BLOCKED: private denylist matched ($HITS line[s]): $pat" >&2
            printf '%s\n' "$ADDED" | grep -nE "$pat" | head -5 >&2
            FAIL=1
        fi
    done < "$DENYLIST"

    # Example-allowlist enforcement (CR-029): any name-like token in the added
    # lines must be a declared INVENTED example. Unknown real names can't be
    # enumerated — allowed fake ones can.
    SCAN="$(git rev-parse --show-toplevel)/scripts/privacy-scan.sh"
    if [ -x "$SCAN" ]; then
        OUT=$(printf '%s\n' "$ADDED" | "$SCAN" --stdin 2>&1)
        if [ $? -ne 0 ]; then
            echo "PUSH BLOCKED by privacy-scan (CR-029):" >&2
            echo "$OUT" | grep -A2 "FINDING" | head -12 >&2
            FAIL=1
        fi
    fi
done

if [ "$FAIL" -ne 0 ]; then
    echo "" >&2
    echo "Review the lines above. If a hit is a false positive, refine the" >&2
    echo "denylist regex; if the content is genuinely public-safe, rewrite it" >&2
    echo "generically. Conscious override: git push --no-verify (review first)." >&2
    exit 1
fi
exit 0
