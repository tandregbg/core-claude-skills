{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-skills/company-sources.schema.json",
  "title": "company sources.yaml: where the facts live, and what is off-limits (CR-125)",
  "type": "object",
  "required": ["vertical", "updated", "sources"],
  "additionalProperties": false,
  "properties": {
    "vertical": {"type": "string", "minLength": 1},
    "updated": {"type": "string", "format": "date"},
    "labels": {"type": "object",
               "$comment": "meaning of the id prefixes the profile uses in its text, e.g. {Q: open strategy question, D: decision in the register}"},
    "exclude": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "except": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "authority", "feeds"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^s-[a-z0-9][a-z0-9-]*$"},
          "kind": {"enum": ["vault", "host", "repo", "url", "intake", "interview"]},
          "path": {"type": "string", "minLength": 1},
          "authority": {"enum": ["binding", "current", "public", "draft"]},
          "feeds": {"type": "array", "uniqueItems": true,
                    "items": {"enum": ["essence", "company", "offering", "positioning", "messaging", "gtm", "strategy", "brand", "public"]},
                    "$comment": "facet names; empty = declared for context only"},
          "as_of": {"type": "string", "format": "date",
                    "$comment": "when a captured copy was taken; with origin_url, lets a public fact cite an internal capture"},
          "origin_url": {"type": "string", "minLength": 1},
          "curation": {"enum": ["original", "derived", "curated"],
                       "$comment": "original: the document itself; derived: extracted or summarised from one; curated: a tool or team's own processed layer"},
          "derived_from": {"type": "string", "minLength": 1, "$comment": "the register id or locator of the original a derived or curated source comes from"},
          "decided_by": {"type": "string", "minLength": 1, "$comment": "who in the company made the decision a binding source records (a role)"},
          "pages": {"type": "integer", "minimum": 1, "$comment": "page count of a paged original; bounds the (p. N) citations"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
